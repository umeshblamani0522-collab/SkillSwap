# ============================================================
# Skill Exchange Platform - environment configuration template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ---- Database ----
DB_NAME=skillexchange
DB_USERNAME=skillexchange_user
DB_PASSWORD=replace-with-your-local-database-password
DB_PORT=5433

# ---- Backend / Spring Boot ----
SERVER_PORT=8080
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=86400000

# Browser access: localhost and same-LAN PCs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.*.*:5173,http://10.*.*.*:5173,http://172.16.*.*:5173,http://172.17.*.*:5173,http://172.18.*.*:5173,http://172.19.*.*:5173,http://172.20.*.*:5173,http://172.21.*.*:5173,http://172.22.*.*:5173,http://172.23.*.*:5173,http://172.24.*.*:5173,http://172.25.*.*:5173,http://172.26.*.*:5173,http://172.27.*.*:5173,http://172.28.*.*:5173,http://172.29.*.*:5173,http://172.30.*.*:5173,http://172.31.*.*:5173
SHOW_SQL=false

# ---- Frontend / Vite ----
# Leave these unset for LAN-friendly relative URLs.
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=/ws
FRONTEND_PORT=5173
BACKEND_URL=http://localhost:8080

# ---- Real email verification (required) ----
APP_MAIL_MODE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-real-email@gmail.com
MAIL_PASSWORD=your-email-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Optional explicit frontend URL for verification/reset links when no Origin is available.
# For LAN demo, use the host PC's address, for example:
# FRONTEND_URL=http://192.168.0.101:5173

# ---- AWS (optional) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
